{
    "$schema": "https://raw.githubusercontent.com/pterodactyl/panel/2.0-develop/packages/sdk/manifest.schema.json",
    "id": "left-sidebar",
    "name": "Left Sidebar Navigation",
    "version": "2.0.0",
    "description": "Transforms Pterodactyl 2.0 server navigation into an elegant, vertical left sidebar with active highlights and fluid transitions.",
    "author": "Azion",
    "requires": {
        "panel": "^2.0.0-beta.1",
        "sdk": "^2.0.0-beta.6",
        "php": "^8.3"
    },
    "provider": "LeftSidebar\\LeftSidebarProvider",
    "autoload": {
        "LeftSidebar\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "lsb"
    }
}
